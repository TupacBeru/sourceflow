{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SourceFlow",
  "version": "0.1.0",
  "identifier": "dev.sourceflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SourceFlow",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Lightweight GitHub Git client for Fedora / KDE",
    "longDescription": "A native-feeling Git GUI focused on GitHub, built with Tauri and React.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libsecret-1-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "libsecret"]
      }
    }
  },
  "plugins": {}
}
